{
  "manifest_version": 3,
  "name": "Moonaroon",
  "version": "0.7.0",
  "description": "Dark mode for Cybozu Garoon and Kintone.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://*.cybozu.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moonaroon — Dark mode for Garoon",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.cybozu.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
